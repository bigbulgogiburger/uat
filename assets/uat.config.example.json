{
  "_comment": "UAT 프로필 예시(가상의 쇼핑 앱). 프로젝트 저장소 밖 또는 저장소의 비밀이 아닌 위치에 두고 UAT_CONFIG 로 가리킨다. '_' 로 시작하는 키는 설명용이라 스크립트가 무시한다. 항목 설명은 references/environment.md §1.",

  "project": "shop-app",
  "repo": "~/work/shop-app",
  "runs_dir": "~/.claude/uat-runs/shop-app",
  "lane_guide": "~/.claude/uat-runs/shop-app/lane-guide.md",
  "secrets_file": "~/.uat-secrets/shop-app/secrets.json",
  "data_prefix": "UAT",

  "areas": {
    "A": "앱 시작·권한",
    "B": "로그인·회원",
    "C": "홈",
    "D": "주문서 작성",
    "E": "주문 내역·상세",
    "F": "결제 결과",
    "G": "알림",
    "H": "고객센터·FAQ",
    "M": "MY·설정",
    "X": "API·보안 계약",
    "Z": "종단 저니·디자인 일관성"
  },

  "methods": ["ui", "api", "ui+api", "ui+db", "api+db", "manual"],

  "drivers": { "ui": "android" },

  "android": {
    "adb": "adb",
    "package": "com.example.shop",
    "serial": "emulator-5554",
    "clip_dex": "/data/local/tmp/uat-clip.dex"
  },

  "api": {
    "base_url": "http://127.0.0.1:8080/api/v1",
    "timeout_s": 20,
    "default_headers": { "X-Forwarded-For": "203.0.113.10" },
    "auth_header": { "Authorization": "Bearer {{@.ACCESS}}" },
    "login": [
      { "method": "POST", "path": "/auth/sms/send", "body": { "phone": "{{@.PHONE}}" } },
      { "method": "POST", "path": "/auth/sms/verify", "body": { "phone": "{{@.PHONE}}", "code": "{{@.CODE}}" },
        "save": { "ACCESS": "data.accessToken", "REFRESH": "data.refreshToken" } }
    ],
    "refresh": [
      { "method": "POST", "path": "/auth/token/refresh", "body": { "refreshToken": "{{@.REFRESH}}" },
        "save": { "ACCESS": "data.accessToken", "REFRESH": "data.refreshToken" } }
    ],
    "token_ttl_s": 600
  },

  "db": {
    "read":  ["mysql", "--defaults-extra-file=~/.uat-secrets/shop-app/my.cnf", "-N", "-B", "-e", "{sql}", "shop_dev"],
    "write": ["mysql", "--defaults-extra-file=~/.uat-secrets/shop-app/my.cnf", "-e", "{sql}", "shop_dev"],
    "write_guard": "UAT"
  },

  "redact_patterns": [
    "(?<!\\d)01[016789][-. ]?\\d{3,4}[-. ]?\\d{4}(?!\\d)",
    "eyJ[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}",
    "(?i)bearer\\s+[A-Za-z0-9._-]{16,}"
  ],

  "lanes": {
    "api_methods": ["api"],
    "ui_groups": [["shell", "ACG"], ["order", "DF"], ["history", "E"], ["support", "H"], ["my", "M"], ["journey", "Z"]],
    "ui_parallel": 1,
    "after_api": ["auth"],
    "route_rules": [{ "lane": "auth", "match": "탈퇴|로그아웃|회원가입", "field": "title" }],
    "isolated": { "outage": ["X-21", "X-22"] },
    "chunk": 16,
    "api_chunk": 24,
    "model": "opus",
    "effort": "xhigh"
  },

  "carry_work": ["requests.jsonl", "db-writes.log", "state-snapshots.json", "driver-notes.md"],

  "_notes": {
    "secrets_file": "별칭별 비밀 값. 모양은 assets/examples/secrets.example.json. 저장소 밖에 두고 권한을 본인만 읽게 한다.",
    "redact_patterns": "기본값은 휴대폰 번호(한국 형식)·JWT·Bearer 토큰. 프로젝트의 주민번호·카드번호·이메일 등 민감 꼴을 더한다. verdict.py 가 이 패턴에 걸리는 기록을 거부한다.",
    "ui_groups": "[레인, 영역문자들] — 배열 순서가 실행 순서다. 같은 기기를 쓰므로 한 번에 ui_parallel 개만 돈다.",
    "after_api": "세션·계정을 파괴하는 레인(탈퇴·로그아웃 반복). API 레인이 끝난 뒤에 돈다.",
    "isolated": "서버를 내렸다 올리는 등 다른 레인 상태를 지우는 TC. 별도 레인으로 맨 끝에 돈다."
  }
}
